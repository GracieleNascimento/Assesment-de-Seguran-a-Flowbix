# Copie para apps/server/.env e ajuste. Nunca versione o .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8090
LOG_LEVEL=info

# Banco (docker compose up -d sobe este Postgres)
DATABASE_URL=postgresql://flowbix:flowbix_dev@localhost:5432/flowbix_assessment
# Banco usado só pelos testes de integração (npm test); é recriado a cada execução
DATABASE_URL_TESTE=postgresql://flowbix:flowbix_dev@localhost:5432/flowbix_assessment_teste

# JWT: gere com  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Origens liberadas para o frontend (separadas por vírgula; vazio = nenhuma)
CORS_ORIGINS=http://localhost:5173
# Requisições por minuto por IP
RATE_LIMIT_MAX=300

# Primeiro administrador (usado por npm run db:seed)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@flowbix.com
ADMIN_SENHA=troque-esta-senha-forte

# Segredos das plataformas, referenciados nos ambientes como "env:NOME"
GRAFANA_TOKEN=
