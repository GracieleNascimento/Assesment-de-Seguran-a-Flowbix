{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@flowbix/core": ["packages/core/src/index.ts"],
      "@flowbix/knowledge": ["packages/knowledge/src/index.ts"],
      "@flowbix/report": ["packages/report/src/index.ts"],
      "@flowbix/module-grafana-security": ["modules/module-grafana-security/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "modules/*/src/**/*", "apps/*/src/**/*"]
}
