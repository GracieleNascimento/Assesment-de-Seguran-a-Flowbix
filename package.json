{
  "name": "flowbix-assessment",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma modular de assessment Flowbix (técnico + segurança) para Zabbix, Grafana, Elastic, Graylog.",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run prisma:generate -w @flowbix/server && tsc --build",
    "clean": "tsc --build --clean",
    "dev": "npm run dev -w @flowbix/server",
    "start": "npm start -w @flowbix/server",
    "test": "npm test -w @flowbix/server",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @flowbix/server",
    "db:deploy": "npm run db:deploy -w @flowbix/server",
    "db:seed": "npm run db:seed -w @flowbix/server",
    "db:studio": "npm run db:studio -w @flowbix/server"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
